# ---- Used by docker-compose (copy to .env) ---------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Shared secret between the web app and the MCP server. Use a long random value:
#   openssl rand -hex 32
MCP_API_KEY=dev-mcp-key-change-me
MYSQL_ROOT_PASSWORD=rootpass

# Optional
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max
MCP_MODE=local                # local | connector (see README)
MCP_PUBLIC_URL=               # https://mcp.example.com/mcp, required for MCP_MODE=connector
WEB_BASIC_AUTH=               # user:password to protect the chat UI

# ---- Running the MCP server outside Docker (mcp-server/.env) ---------------
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=your_database
# MYSQL_USER=mcp_reader
# MYSQL_PASSWORD=...
# MCP_API_KEYS=key1,key2            # comma-separated, one per client
# ALLOWED_TABLES=customers,orders   # or * for every table the user can see
# QUERY_ROW_LIMIT=500
# QUERY_TIMEOUT_MS=5000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60                 # requests per key per window
# QUERY_LOG_FILE=./queries.log
# ALLOWED_HOSTS=mcp.example.com     # Host header allowlist (DNS-rebinding protection)
# PORT=8080

# ---- Running the web app outside Docker (web/.env.local) -------------------
# ANTHROPIC_API_KEY=sk-ant-...
# MCP_SERVER_URL=http://localhost:8080/mcp
# MCP_API_KEY=key1
