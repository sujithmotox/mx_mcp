# Copy to .env and fill in.
MYSQL_HOST=your-db-host.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=your_database
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password

# Secret the web app must send. Any long random string.
MCP_API_KEYS=change-me-to-a-long-random-string

# Tables the assistant may read: comma-separated names, or * for all.
ALLOWED_TABLES=*

# Optional
# QUERY_ROW_LIMIT=500
# QUERY_TIMEOUT_MS=5000
# RATE_LIMIT_MAX=60
# QUERY_LOG_FILE=./queries.log
# PORT=8080
