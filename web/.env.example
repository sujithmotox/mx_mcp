# Copy to .env.local and fill in.
ANTHROPIC_API_KEY=sk-ant-...
MCP_SERVER_URL=http://localhost:8080/mcp
# Must match one of MCP_API_KEYS in mcp-server/.env
MCP_API_KEY=change-me-to-a-long-random-string

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# WEB_BASIC_AUTH=user:password

# Dashboard: where pinned widgets are saved (default web/data/widgets.json)
# WIDGETS_FILE=/var/lib/mx-data/widgets.json
# Turns on "Copy embed code" for showing widgets in another app. Any long random string.
# WIDGET_EMBED_SECRET=
